[Unit]
Description=Booran South Morang BYD Virtual Yard import
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=booran
Group=booran
WorkingDirectory=/var/www/booran/current/backend
Environment=NODE_ENV=production
Environment=VIRTUALYARD_DATA_DIR=/var/www/booran/shared/virtualyard
UMask=0077
Nice=10
TimeoutStartSec=55min
ExecStart=/opt/booran-node22/bin/node scripts/sync-virtualyard.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/booran/shared/virtualyard
