MONGODB_URI_FLWUP=mongodb+srv://USER:PASSWORD@HOST/flwup_crm
MONGODB_URI_BOORAN=mongodb+srv://USER:PASSWORD@HOST/booran_inventory_tracker
SMS_CAMPAIGN_DB_NAME=mongodb+srv://USER:PASSWORD@HOST/sms_campaign
# SMS_CAMPAIGN_DB_NAME accepts a database name or a full connection URI.
# A dedicated URI takes precedence when both settings are provided.
# MONGODB_URI_SMS_CAMPAIGN=mongodb+srv://USER:PASSWORD@HOST/sms_campaign
# Only needed when migrating the former shared app-state storage.
# LEGACY_APP_STATE_COLLECTION=dashboards
# Optional, comma-separated origins for direct browser calls to the backend.
# The Next.js proxy does not need CORS or cross-site cookies.
ALLOWED_ORIGINS=http://localhost:3000
PORT=5001

# Mobile Message (use the same approved provider account as Delivery Centre).
MOBILEMESSAGE_USERNAME=
MOBILEMESSAGE_PASSWORD=
MOBILEMESSAGE_SENDER_ID=
# MOBILEMESSAGE_FROM is accepted as an alternative to MOBILEMESSAGE_SENDER_ID.
# MOBILEMESSAGE_API_URL=https://api.mobilemessage.com.au/v1/messages
# Optional inbox endpoint override. Replies sync every 15 seconds while a customer card is open.
# MOBILEMESSAGE_INBOUND_API_URL=https://api.mobilemessage.com.au/v1/inbound

# auto uses local disk on a normal server and MongoDB chunks on Vercel.
MEDIA_STORAGE_BACKEND=auto
# Local disk paths resolve from the backend project directory.
MEDIA_STORAGE_DIR=storage/media
# Set a publicly reachable HTTPS backend URL before sending links to clients.
BACKEND_PUBLIC_URL=http://localhost:5001

# Nextgate. Keep these credentials on the backend.
NEXGATE_TOKEN=
NEXGATE_USER_ID=
NEXGATE_SELLER_GUID=
# Use different random values with at least 24 characters.
CRON_SECRET=
NEXGATE_WEBHOOK_SECRET=
# Standalone server only. Optional first-page poll when a push feed is unavailable.
# NEXGATE_LIVE_POLL_MS=15000

# Optional exact dealership-to-approved-sender map. A missing site is disabled when set.
# MOBILEMESSAGE_SENDERS_JSON={"South Morang Kia":"APPROVED_SENDER"}
EXPO_PUSH_ENABLED=false
EXPO_PUSH_ACCESS_TOKEN=

# HTTPS provider adapters. See the README for request and response contracts.
REGO_LOOKUP_URL=
REGO_LOOKUP_TOKEN=
PPSR_URL=
PPSR_TOKEN=
INSPECTION_AI_URL=
INSPECTION_AI_TOKEN=
SMS_DRAFT_URL=
SMS_DRAFT_TOKEN=
BOORAN_DMS_URL=
BOORAN_DMS_TOKEN=

# South Morang Hyundai inbound lead mail. Create both Hostinger mailboxes first.
# Credentials remain backend-only; a configured inbox is polled every 60 seconds.
# HYUNDAI_INBOUND_IMAP_HOST=imap.hostinger.com
# HYUNDAI_INBOUND_NEW_USER=SMHYNew@goodshowroom.com
HYUNDAI_INBOUND_NEW_PASSWORD=
# HYUNDAI_INBOUND_USED_USER=SMHYUsed@goodshowroom.com
HYUNDAI_INBOUND_USED_PASSWORD=
# Optional alternative: secret-authenticated email-provider webhook (32+ random characters).
HYUNDAI_INBOUND_EMAIL_SECRET=
# Optional: reuse an existing operational collection on hosts at collection capacity.
# Set before enabling the lead-state features; keep the same value on later releases.
# LEAD_STATE_COLLECTION=nexgate_sync
